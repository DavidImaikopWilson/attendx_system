# ============================================================
# LOCAL DEVELOPMENT ONLY.
#
# Copy to .env (same folder as app.py). .env is gitignored and is
# NEVER uploaded to Vercel.
#
# Do NOT paste these values into the Vercel dashboard. Every host
# below is "localhost", which on Vercel means the serverless
# function's own container - there is no database inside it, so the
# deploy fails with "connection to server at localhost ... refused".
# See README "Deploying to Vercel" for what to set there instead.
# ============================================================

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-string

# ---- Database connection string (pick ONE) ----

# SQLite - simplest local option, no server to run.
DATABASE_URL=sqlite:///attendance.db

# Local PostgreSQL, if you run one on this machine.
# DATABASE_URL=postgresql://username:password@localhost:5432/attendance_db

# Local MySQL, if you run one on this machine.
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/attendance_db

# Optional: force Secure cookies when not on Vercel (e.g. behind an HTTPS proxy)
# SESSION_COOKIE_SECURE=true
